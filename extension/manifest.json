{
  "manifest_version": 3,
  "name": "Daystar Bus Booking",
  "version": "1.0.1",
  "description": "Open the Daystar University bus booking app from your browser.",
  "action": {
    "default_title": "Daystar Bus Booking",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://your-live-app-url.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
