{
  "manifest_version": 3,
  "name": "Daystar Bus Booking",
  "version": "1.0.0",
  "description": "Book Daystar University bus tickets from the browser.",
  "action": {
    "default_title": "Daystar Bus Booking",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
