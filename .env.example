PORT=3000
NODE_ENV=development
MONGODB_URI=
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SOCKET_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_ENV=Sandbox
# Required. Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will not start without JWT_SECRET.
OTP_HMAC_SECRET=
JWT_SECRET=
# console = print codes in the server log (local development only; ignored when NODE_ENV=production).
# Otherwise codes are emailed: through Brevo's API if BREVO_API_KEY is set, else through SMTP.
OTP_DELIVERY_MODE=
# Brevo (recommended): API key from Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Sender shown on the emails. Must be a sender address verified in Brevo.
# Either "buses@example.com" or "Daystar Bus <buses@example.com>".
EMAIL_FROM=
# SMTP (fallback, only used when BREVO_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
